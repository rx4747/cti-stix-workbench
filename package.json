{
  "name": "cti-stix-workbench",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm prepare:validation && node esbuild.config.mjs production",
    "check:release": "pnpm package:plugin && node scripts/check-release.mjs",
    "check": "pnpm verify:sources && pnpm test && pnpm lint && pnpm typecheck && pnpm format:check",
    "commitlint": "commitlint --last --verbose",
    "dev": "node esbuild.config.mjs",
    "install:dev": "pnpm build && node scripts/install-dev.mjs",
    "format": "biome check --write .",
    "format:check": "biome ci .",
    "lint": "pnpm lint:marketplace",
    "lint:marketplace": "eslint --max-warnings 0 src",
    "package:plugin": "pnpm build && node scripts/package-release.mjs plugin",
    "prepare:validation": "node scripts/build-validation.mjs",
    "prepare": "husky",
    "release:bump": "node scripts/bump-release-version.mjs",
    "smoke": "pnpm build && node scripts/smoke-bundle.mjs",
    "test": "pnpm prepare:validation && vitest run",
    "typecheck": "pnpm prepare:validation && tsc --noEmit",
    "verify:sources": "node scripts/verify-sources.mjs standards/sources.json"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "dependencies": {
    "antlr4ng": "^3.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@biomejs/biome": "2.5.5",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "24.13.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "antlr-ng": "^1.0.10",
    "esbuild": "^0.28.1",
    "eslint": "10.8.0",
    "eslint-plugin-obsidianmd": "0.4.1",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "obsidian": "1.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.17.0",
  "lint-staged": {
    "*.{js,mjs,ts,json,jsonc,css}": "biome check --write --no-errors-on-unmatched",
    "src/**/*.ts": "eslint --max-warnings 0 --no-warn-ignored"
  }
}
