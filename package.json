{
  "name": "cti-stix-workbench",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm prepare:validation && node esbuild.config.mjs production",
    "check:release": "pnpm package:plugin && node scripts/check-release.mjs",
    "check": "pnpm verify:sources && pnpm check:generated && pnpm check:docs && pnpm check:security && pnpm test && pnpm lint && pnpm typecheck && pnpm format:check",
    "check:docs": "node scripts/check-docs.mjs",
    "check:coverage": "node scripts/check-coverage.mjs",
    "check:generated": "node scripts/generate-catalog.mjs --check && node scripts/generate-vault-example.mjs --check && node scripts/generate-analyst-workflows.mjs --check && pnpm check:coverage",
    "check:push": "pnpm lint && pnpm typecheck && pnpm test && pnpm smoke",
    "check:security": "node scripts/security-audit.mjs",
    "commitlint": "commitlint --last --verbose",
    "dev": "node esbuild.config.mjs",
    "install:dev": "pnpm build && node scripts/install-dev.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "generate": "node scripts/generate-catalog.mjs && node scripts/generate-analyst-workflows.mjs",
    "generate:workflows": "node scripts/generate-analyst-workflows.mjs",
    "generate:vault-example": "node scripts/generate-vault-example.mjs",
    "lint": "pnpm lint:biome && pnpm lint:marketplace",
    "lint:biome": "biome lint --error-on-warnings .",
    "lint:marketplace": "eslint --max-warnings 0 src package.json",
    "package:plugin": "pnpm build && node scripts/package-release.mjs plugin",
    "prepare:validation": "node scripts/build-validation.mjs",
    "prepare": "husky",
    "release:bump": "node scripts/bump-release-version.mjs",
    "smoke": "pnpm build && node scripts/smoke-bundle.mjs",
    "test": "pnpm prepare:validation && vitest run",
    "typecheck": "pnpm prepare:validation && tsc --noEmit",
    "verify:sources": "node scripts/verify-sources.mjs standards/sources.json"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "dependencies": {
    "antlr4ng": "^3.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "antlr-ng": "^1.0.10",
    "esbuild": "^0.28.1",
    "eslint": "10.8.0",
    "eslint-plugin-obsidianmd": "0.4.1",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "nano-staged": "1.0.2",
    "obsidian": "1.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.17.0",
  "nano-staged": {
    "*.{js,mjs,ts,json,jsonc,css}": "biome check --write --error-on-warnings --no-errors-on-unmatched"
  }
}
